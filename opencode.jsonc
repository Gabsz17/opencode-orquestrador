{
  // Config base do sistema orquestrador. Agents em `agents/*.md` são descobertos automaticamente.
  // Permissões específicas de cada agent estão no frontmatter; aqui fica só a base segura global.
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orquestrador",
  "permission": {
    "external_directory": "deny",
    "bash": {
      "git push --force*": "deny",
      "git push * --force*": "deny",
      "git push * -f*": "deny",
      "git push * --delete*": "deny",
      "rm -rf*": "deny"
    }
  },
  // MCP declarados (versão OpenCode com suporte a `mcp`; se a versão local não suportar, o bloco é ignorado e vale webfetch/websearch).
  // Docs de cada servidor em docs/mcp.md.
  "mcp": {
    "repo": { "type": "local", "command": ["opencode-mcp-repo"], "enabled": false },
    "docs": { "type": "local", "command": ["opencode-mcp-docs"], "enabled": false },
    "browser": { "type": "local", "command": ["opencode-mcp-browser"], "enabled": false }
  }
}
